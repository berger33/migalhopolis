# Python and local development artifacts
__pycache__/
*.pyc

# Intermediários de croma e previews de validação (entregáveis vão para assets/)
raw/
.pytest_cache/
.venv/
node_modules/

# Reproducible audio/video intermediates
production/audio/segments/
production/audio/*.wav
video/cache/
video/intermediario/
video/*.log

# Final renders are large and mostly ignored by default; keep published outputs
# tracked explicitly so their delivery paths stay stable.
video/*.mov
video/*.mp4
!video/parte_01.mp4
!video/parte_02.mp4
!video/parte_03.mp4
!video/MIGALHOPOLIS_T1E1.mp4
!video/TEASER_T1E1.mp4
